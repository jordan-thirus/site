<!doctype html>
<html lang="{{ metadata.language }}" color-mode="user">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% if title %}{{ title }} - {% endif %}{{ metadata.title }}
		</title>
				<meta name="description" content="{{ description or metadata.description }}">

		<link rel="alternate" href="/feed.xml" type="application/rss+xml" title="{{ metadata.title }}">

		<meta name="generator" content="{{ eleventy.generator }}">

		<link href="/styles.min.css" rel="stylesheet"/>
	</head>
	<body class="container">
			<main>
				<header>
					<nav>
						<ul>
					<li>
						<a href="/" class="site-title">{{ metadata.title}}</a>
						</li>
						</ul>
					{{ collections.all | eleventyNavigation | eleventyNavigationToHtml | safe }}
				</nav>
				</header>
				{{ content | safe }}
				<footer>
					<nav>
						<ul>
							<li>
					<a href="/feed.xml">
						<i class="fa-solid fa-rss"></i>
						<span class="sr-only">RSS Feed</span>
					</a> 
				</li>
				<li>
					<a href="https://github.com/jordan-thirus/" target="_blank">
						<i class="fa-brands fa-github"></i>
						<span class="sr-only">Github</span>
					</a> 
				</li>
				<li>
					<a href="https://www.linkedin.com/in/jordan-thirus/" target="_blank">
						<i class="fa-brands fa-linkedin"></i>
						<span class="sr-only">LinkedIn</span>
					</a>
				</li>
				<li>
					  <a href="/colophon">
						<span class="sr-only">Colophon (About this Site)</span>
						Colophon
					</a>
				</li>
						</ul>
					</nav>
				</footer>
			</main>
	</body>
	{% getBundle "fontawesome" %}
</html>